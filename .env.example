# Copy to .env for local development only. Never commit .env.
# Lines starting with "#" are optional; remove the "#" to set them.

# --- Okta orgs (required) ---
# Comma-separated org names, any number. For each name NAME there must be
# OKTA_ADMIN_NAME_URL, and a token in OKTA_ADMIN_NAME_API_TOKEN (or in the OS keyring).
# The first org listed is the default one. Names: letters, digits, "-" and "_".
OKTA_ADMIN_ORGS=
# Example for an org called "main":
# OKTA_ADMIN_MAIN_URL=https://your-org.okta.com
# OKTA_ADMIN_MAIN_API_TOKEN=

# --- Sign-in (required unless AUTH_MODE=none) ---
# Default: oidc. Set AUTH_MODE=none to turn sign-in off (local use only).
# AUTH_MODE=none
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
APP_BASE_URL=
# A long random string. Must be the same for every worker and restart.
FLASK_SECRET_KEY=
# Comma-separated emails allowed to sign in (required with AUTH_MODE=oidc).
OIDC_ALLOWED_EMAILS=
# Text shown on the login page when the identity provider answers access_denied.
# Default: a generic message.
# ACCESS_DENIED_NOTICE=

# --- Server ---
# Default 127.0.0.1 (the container binds 0.0.0.0).
# HOST=127.0.0.1
# Default 5002 locally, 8080 in the container.
# PORT=5002
# Default: okta-admin-actions.log next to app.py.
# ACTION_LOG_PATH=

# --- Optional ---
# Default: okta-app-admin
# KEYRING_SERVICE=okta-app-admin
# Auth-count overlay from Azure Tables. Default: off.
# AZURE_STORAGE_CONNECTION_STRING=
# Default: appauthcounts
# TABLE_UNITS=appauthcounts
# Default: true. Set to false only behind a TLS-inspecting proxy.
# AZURE_TLS_VERIFY=true
